<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView style="@style/Text.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:text="@string/browser_title" android:textSize="20sp" />
    <TextView style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingTop="4dp" android:text="@string/browser_notice" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingHorizontal="12dp">
        <com.google.android.material.button.MaterialButton style="@style/Widget.Road.IconButton" android:id="@+id/browser_back" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/back" app:icon="@drawable/ic_back" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Road.IconButton" android:id="@+id/browser_forward" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/forward" app:icon="@drawable/ic_forward" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Road.IconButton" android:id="@+id/browser_home" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/youtube_home" app:icon="@drawable/ic_home" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Road.IconButton" android:id="@+id/browser_reload" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/reload" app:icon="@drawable/ic_reload" />
        <View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton style="@style/Widget.Road.IconButton" android:id="@+id/browser_external" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/open_external" app:icon="@drawable/ic_external" />
    </LinearLayout>
    <ProgressBar android:id="@+id/browser_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:progressTint="@color/accent" />
    <TextView android:id="@+id/browser_status" style="@style/Text.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:text="@string/browser_loading" android:accessibilityLiveRegion="polite" />
    <FrameLayout android:id="@+id/web_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
